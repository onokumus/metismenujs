{
	"name": "metismenujs",
	"version": "1.5.0",
	"description": "MetisMenu: Collapsible menu plugin with Vanilla-JS",
	"type": "module",
	"main": "./dist/metismenujs.cjs",
	"module": "./dist/index.mjs",
	"browser": "./dist/metismenujs.js",
	"unpkg": "./dist/metismenujs.js",
	"jsdelivr": "./dist/metismenujs.js",
	"typings": "./dist/metismenujs.d.cts",
	"types": "./dist/metismenujs.d.cts",
	"sass": "./src/metismenujs.scss",
	"style": "./dist/metismenujs.css",
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/types/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/types/metismenujs.d.cts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json",
		"./sass": "./src/metismenujs.scss",
		"./style": "./dist/metismenujs.css",
		"./dist/*": "./dist/*"
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build:js": "tsdown",
		"build:css": "sass src:dist && sass src/metismenujs.scss dist/metismenujs.min.css -s compressed",
		"build": "npm run check && npm run typecheck && npm run build:js && npm run build:css",
		"check": "biome check --write",
		"lint": "biome lint",
		"format": "biome format",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"css:dev": "sass src:docs/assets/css -w -s compressed",
		"prepublishOnly": "npm run build"
	},
	"repository": "onokumus/metismenujs",
	"keywords": [
		"accordion",
		"menu",
		"metis",
		"metisMenu",
		"toggle"
	],
	"author": "Osman Nuri Okumus <onokumus@gmail.com> (https://github.com/onokumus)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/onokumus/metismenujs/issues"
	},
	"homepage": "https://github.com/onokumus/metismenujs#readme",
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"sass": "^1.104.1",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true
	}
}
